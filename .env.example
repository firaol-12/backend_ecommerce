# --- Server ---
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce
JWT_SECRET=super-secret-key-change-me
NODE_ENV=development

# --- Chapa payment gateway (https://developer.chapa.co) ---
# Get a secret key from your Chapa dashboard (test or live).
CHAPA_SECRET_KEY=CHASECK_TEST-Sxo1rqH51ORq7M8rd8ItOQ6pq8JKo8Ek
# Public key (only needed for the Chapa.js browser modal; not used by the
# hosted-redirect flow, safe to expose in the frontend if you switch to it).
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-bZzxmWdYrFltgW3iPSdqqHzahwYgcjbd
# Encryption key: verifies Chapa's webhook signatures (HMAC). From your
# Chapa dashboard "Webhooks" section. Optional but recommended.
CHAPA_WEBHOOK_SECRET=ANNgojM1iCtHB8MMPTt3AqiX
# Leave as-is unless you use a sandbox endpoint.
CHAPA_API_URL=https://api.chapa.co
# Public base URL that Chapa redirects the customer back to after payment.
CHAPA_CALLBACK_URL=http://localhost:3000
